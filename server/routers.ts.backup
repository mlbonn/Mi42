import { COOKIE_NAME } from "@shared/const";
import { getSessionCookieOptions } from "./_core/cookies";
import { systemRouter } from "./_core/systemRouter";
import { scoutRouter } from "./scoutRouter";
import { hunterRouter } from "./hunterRouter";
import { outreachRouter } from "./outreachRouter";
import { authRouter } from "./authRouter";
import { settingsRouter } from "./settingsRouter";
import { userRouter } from "./userRouter";
import { templatesRouter } from "./templatesRouter";
import { draftsRouter } from "./draftsRouter";
import { responsesRouter } from "./responsesRouter";
import { hunterResultsRouter } from "./hunterResultsRouter";
import { calendarRouter } from "./calendarRouter";
import { attachmentRouter } from "./attachmentRouter";
import { publicProcedure, protectedProcedure, router } from "./_core/trpc";
import { TRPCError } from "@trpc/server";
import { z } from "zod";
import * as db from "./db";

// ============================================================================
// PERMISSION PROCEDURES
// ============================================================================

const adminProcedure = protectedProcedure.use(({ ctx, next }) => {
  if (ctx.user.role !== 'admin') {
    throw new TRPCError({ code: 'FORBIDDEN', message: 'Admin access required' });
  }
  return next({ ctx });
});

const salesProcedure = protectedProcedure.use(({ ctx, next }) => {
  if (!['admin', 'sales_manager', 'external_sales'].includes(ctx.user.role)) {
    throw new TRPCError({ code: 'FORBIDDEN', message: 'Sales access required' });
  }
  return next({ ctx });
});

// ============================================================================
// APP ROUTER
// ============================================================================

export const appRouter = router({
  system: systemRouter,
  scout: scoutRouter,
  hunter: hunterRouter,
  outreach: outreachRouter,
  auth: authRouter,
  settings: settingsRouter,
  users: userRouter,
  templates: templatesRouter,
  drafts: draftsRouter,
  responses: responsesRouter,
  hunterResults: hunterResultsRouter,
  calendar: calendarRouter,
  attachments: attachmentRouter,

  // ==========================================================================
  // CORPORATIONS
  // ==========================================================================
  
  corporations: router({
    list: salesProcedure.query(async ({ ctx }) => {
      return await db.getCorporations(ctx.user.id);
    }),

    get: salesProcedure
      .input(z.object({ id: z.string() }))
      .query(async ({ ctx, input }) => {
        const canAccess = await db.canUserAccessCorporation(ctx.user.id, input.id);
        if (!canAccess) {
          throw new TRPCError({ code: 'FORBIDDEN', message: 'Access denied' });
        }
        return await db.getCorporation(input.id);
      }),

    create: salesProcedure
      .input(z.object({
        name: z.string(),
        headquartersCountry: z.string().optional(),
        totalRevenueEur: z.number().optional(),
        industry: z.string().optional(),
        website: z.string().optional(),
        linkedinUrl: z.string().optional(),
        status: z.string().optional(),
        priority: z.string().optional(),
        notes: z.string().optional(),
      }))
      .mutation(async ({ input }) => {
        const corpData = {
          name: input.name,
          headquartersCountry: input.headquartersCountry || null,
          totalRevenueEur: input.totalRevenueEur || null,
          industry: input.industry || null,
          website: input.website || null,
          linkedinUrl: input.linkedinUrl || null,
          status: input.status || null,
          priority: input.priority || null,
          notes: input.notes || null,
          companySize: null,
          stage: null,
          // Scout Agent Felder
          products: null,
          targetMarkets: null,
          countries: null,
          referenceCustomers: null,
          employeeCount: null,
          international: false,
          profileAnalyzedAt: null,
          scoutStatus: "Not Analyzed",
          scoutGeneration: 0,
          scoutParentId: null,
          discoveryMethod: null,
          discoveredAt: null,
        };
        return await db.createCorporation(corpData);
      }),

    update: salesProcedure
      .input(z.object({
        id: z.string(),
        name: z.string().optional(),
        headquartersCountry: z.string().optional(),
        totalRevenueEur: z.number().optional(),
        industry: z.string().optional(),
        website: z.string().optional(),
        linkedinUrl: z.string().optional(),
        status: z.string().optional(),
        priority: z.string().optional(),
        notes: z.string().optional(),
        // Genesis World CRM Felder
        companySize: z.string().optional(),
        stage: z.string().optional(),
      }))
      .mutation(async ({ ctx, input }) => {
        const canAccess = await db.canUserAccessCorporation(ctx.user.id, input.id);
        if (!canAccess) {
          throw new TRPCError({ code: 'FORBIDDEN', message: 'Access denied' });
        }
        const { id, ...data } = input;
        return await db.updateCorporation(id, data);
      }),
  }),

  // ==========================================================================
  // COMPANIES
  // ==========================================================================

  companies: router({
    list: salesProcedure
      .query(async ({ ctx }) => {
        return await db.getAllCompanies();
      }),

    listByCorporation: salesProcedure
      .input(z.object({ corporationId: z.string() }))
      .query(async ({ ctx, input }) => {
        const canAccess = await db.canUserAccessCorporation(ctx.user.id, input.corporationId);
        if (!canAccess) {
          throw new TRPCError({ code: 'FORBIDDEN', message: 'Access denied' });
        }
        return await db.getCompaniesByCorporation(input.corporationId);
      }),

    get: salesProcedure
      .input(z.object({ id: z.string() }))
      .query(async ({ input }) => {
        return await db.getCompany(input.id);
      }),

    create: salesProcedure
      .input(z.object({
        corporationId: z.string(),
        name: z.string(),
        legalForm: z.string().optional(),
        country: z.string().optional(),
        city: z.string().optional(),
        address: z.string().optional(),
        revenueEur: z.number().optional(),
        products: z.string().optional(),
        website: z.string().optional(),
        notes: z.string().optional(),
      }))
      .mutation(async ({ ctx, input }) => {
        const canAccess = await db.canUserAccessCorporation(ctx.user.id, input.corporationId);
        if (!canAccess) {
          throw new TRPCError({ code: 'FORBIDDEN', message: 'Access denied' });
        }
        const companyData = {
          corporationId: input.corporationId,
          name: input.name,
          legalForm: input.legalForm || null,
          country: input.country || null,
          city: input.city || null,
          address: input.address || null,
          revenueEur: input.revenueEur || null,
          products: input.products || null,
          website: input.website || null,
          notes: input.notes || null,
        };
        return await db.createCompany(companyData);
      }),

    update: salesProcedure
      .input(z.object({
        id: z.string(),
        name: z.string().optional(),
        legalForm: z.string().optional(),
        country: z.string().optional(),
        city: z.string().optional(),
        address: z.string().optional(),
        revenueEur: z.number().optional(),
        products: z.string().optional(),
        website: z.string().optional(),
        notes: z.string().optional(),
      }))
      .mutation(async ({ input }) => {
        const { id, ...data } = input;
        return await db.updateCompany(id, data);
      }),
  }),

  // ==========================================================================
  // CONTACTS
  // ==========================================================================

  contacts: router({
    list: salesProcedure
      .query(async () => {
        return await db.getAllContacts();
      }),

    findByEmail: salesProcedure
      .input(z.object({ email: z.string().email() }))
      .query(async ({ input }) => {
        const contacts = await db.getAllContacts();
        return contacts.find(c => c.email && c.email.toLowerCase() === input.email.toLowerCase()) || null;
      }),

    search: salesProcedure
      .input(z.object({ query: z.string() }))
      .query(async ({ input }) => {
        const contacts = await db.getAllContacts();
        const query = input.query.toLowerCase();
        return contacts.filter(c => 
          (c.firstName && c.firstName.toLowerCase().includes(query)) ||
          (c.lastName && c.lastName.toLowerCase().includes(query)) ||
          (c.email && c.email.toLowerCase().includes(query))
        ).slice(0, 10);
      }),

    listByCompany: salesProcedure
      .input(z.object({ companyId: z.string() }))
      .query(async ({ input }) => {
        return await db.getContactsByCompany(input.companyId);
      }),

    get: salesProcedure
      .input(z.object({ id: z.string() }))
      .query(async ({ input }) => {
        return await db.getContact(input.id);
      }),

    getCompanies: salesProcedure
      .input(z.object({ contactId: z.string() }))
      .query(async ({ input }) => {
        return await db.getCompaniesByContact(input.contactId);
      }),

    createSimple: salesProcedure
      .input(z.object({
        firstName: z.string(),
        lastName: z.string(),
        email: z.string().email(),
        company: z.string().optional(),
        position: z.string().optional(),
        phone: z.string().optional(),
      }))
      .mutation(async ({ input }) => {
        // Erstelle Kontakt ohne Company-Zuordnung
        const contactData = {
          firstName: input.firstName,
          lastName: input.lastName,
          email: input.email,
          phone: input.phone || null,
          jobTitle: input.position || null,
          mobile: null,
          linkedinUrl: null,
          decisionMaker: null,
          contactStatus: 'active',
          notes: input.company ? `Firma: ${input.company}` : null,
          keyword1: null,
          keyword2: null,
          companySize: null,
          responsiblePerson: null,
          function: null,
          department: null,
          category: null,
          tags: null,
          phoneBusiness: null,
          phoneMobile: null,
          phoneOffice: null,
          faxOffice: null,
        };
        // Erstelle ohne Company-Zuordnung (companyId = null)
        return await db.createContact(contactData, null, input.email, input.position);
      }),

    create: salesProcedure
      .input(z.object({
        companyId: z.string(),
        firstName: z.string(),
        lastName: z.string(),
        jobTitle: z.string().optional(),
        email: z.string().optional(),
        position: z.string().optional(),
        phone: z.string().optional(),
        mobile: z.string().optional(),
        linkedinUrl: z.string().optional(),
        decisionMaker: z.boolean().optional(),
        contactStatus: z.string().optional(),
        notes: z.string().optional(),
        // Genesis World CRM Felder
        keyword1: z.string().optional(),
        keyword2: z.string().optional(),
        companySize: z.string().optional(),
        responsiblePerson: z.string().optional(),
        function: z.string().optional(),
        department: z.string().optional(),
        category: z.string().optional(),
        tags: z.string().optional(),
        phoneBusiness: z.string().optional(),
        phoneMobile: z.string().optional(),
        phoneOffice: z.string().optional(),
        faxOffice: z.string().optional(),
      }))
      .mutation(async ({ input }) => {
        const { companyId, email, position, ...rest } = input;
        const contactData = {
          firstName: input.firstName || null,
          lastName: input.lastName || null,
          jobTitle: input.jobTitle || null,
          phone: input.phone || null,
          mobile: input.mobile || null,
          linkedinUrl: input.linkedinUrl || null,
          decisionMaker: input.decisionMaker || null,
          contactStatus: input.contactStatus || null,
          notes: input.notes || null,
          keyword1: input.keyword1 || null,
          keyword2: input.keyword2 || null,
          companySize: input.companySize || null,
          responsiblePerson: input.responsiblePerson || null,
          function: input.function || null,
          department: input.department || null,
          category: input.category || null,
          tags: input.tags || null,
          phoneBusiness: input.phoneBusiness || null,
          phoneMobile: input.phoneMobile || null,
          phoneOffice: input.phoneOffice || null,
          faxOffice: input.faxOffice || null,
        };
        return await db.createContact(contactData, companyId, email, position);
      }),

    addCompany: salesProcedure
      .input(z.object({
        contactId: z.string(),
        companyId: z.string(),
        email: z.string().optional(),
        position: z.string().optional(),
        isPrimary: z.boolean().optional(),
      }))
      .mutation(async ({ input }) => {
        return await db.addContactToCompany(
          input.contactId,
          input.companyId,
          input.email,
          input.position,
          input.isPrimary
        );
      }),

    update: salesProcedure
      .input(z.object({
        id: z.string(),
        firstName: z.string().optional(),
        lastName: z.string().optional(),
        jobTitle: z.string().optional(),
        phone: z.string().optional(),
        mobile: z.string().optional(),
        linkedinUrl: z.string().optional(),
        decisionMaker: z.boolean().optional(),
        contactStatus: z.string().optional(),
        notes: z.string().optional(),
        // Genesis World CRM Felder
        keyword1: z.string().optional(),
        keyword2: z.string().optional(),
        companySize: z.string().optional(),
        responsiblePerson: z.string().optional(),
        function: z.string().optional(),
        department: z.string().optional(),
        category: z.string().optional(),
        tags: z.string().optional(),
        phoneBusiness: z.string().optional(),
        phoneMobile: z.string().optional(),
        phoneOffice: z.string().optional(),
        faxOffice: z.string().optional(),
      }))
      .mutation(async ({ input }) => {
        const { id, ...data } = input;
        return await db.updateContact(id, data);
      }),
  }),

  // ==========================================================================
  // DEALS
  // ==========================================================================

  deals: router({
    list: salesProcedure.query(async ({ ctx }) => {
      return await db.getDealsByUser(ctx.user.id);
    }),

    listByCorporation: salesProcedure
      .input(z.object({ corporationId: z.string() }))
      .query(async ({ ctx, input }) => {
        const canAccess = await db.canUserAccessCorporation(ctx.user.id, input.corporationId);
        if (!canAccess) {
          throw new TRPCError({ code: 'FORBIDDEN', message: 'Access denied' });
        }
        return await db.getDealsByCorporation(input.corporationId);
      }),

    listByCompany: salesProcedure
      .input(z.object({ companyId: z.string() }))
      .query(async ({ ctx, input }) => {
        return await db.getDealsByCompany(input.companyId);
      }),

    create: salesProcedure
      .input(z.object({
        corporationId: z.string(),
        companyId: z.string().optional(),
        dealName: z.string(),
        dealValueEur: z.string(), // decimal as string
        stage: z.string().optional(),
        probability: z.number().optional(),
        expectedCloseDate: z.date().optional(),
        subscriptionTier: z.string().optional(),
        notes: z.string().optional(),
      }))
      .mutation(async ({ ctx, input }) => {
        const canAccess = await db.canUserAccessCorporation(ctx.user.id, input.corporationId);
        if (!canAccess) {
          throw new TRPCError({ code: 'FORBIDDEN', message: 'Access denied' });
        }
        const dealData = {
          corporationId: input.corporationId,
          companyId: input.companyId || null,
          dealName: input.dealName || null,
          dealValueEur: input.dealValueEur || null,
          stage: input.stage || null,
          probability: input.probability || null,
          expectedCloseDate: input.expectedCloseDate || null,
          subscriptionTier: input.subscriptionTier || null,
          notes: input.notes || null,
          actualCloseDate: null,
          createdBy: null,
        };
        return await db.createDeal(dealData, ctx.user.id);
      }),

    updateStage: salesProcedure
      .input(z.object({
        dealId: z.string(),
        stage: z.string(),
      }))
      .mutation(async ({ input }) => {
        return await db.updateDealStage(input.dealId, input.stage);
      }),
  }),

  // ==========================================================================
  // ACTIVITIES
  // ==========================================================================

  activities: router({
    recent: salesProcedure
      .input(z.object({ limit: z.number().optional() }))
      .query(async ({ ctx, input }) => {
        return await db.getRecentActivities(ctx.user.id, input.limit || 5);
      }),

    listByCorporation: salesProcedure
      .input(z.object({ corporationId: z.string(), limit: z.number().optional() }))
      .query(async ({ ctx, input }) => {
        const canAccess = await db.canUserAccessCorporation(ctx.user.id, input.corporationId);
        if (!canAccess) {
          throw new TRPCError({ code: 'FORBIDDEN', message: 'Access denied' });
        }
        return await db.getActivitiesByCorporation(input.corporationId, input.limit);
      }),

    listByContact: salesProcedure
      .input(z.object({ contactId: z.string(), limit: z.number().optional() }))
      .query(async ({ ctx, input }) => {
        return await db.getActivitiesByContact(input.contactId, input.limit);
      }),

    listByCompany: salesProcedure
      .input(z.object({ companyId: z.string(), limit: z.number().optional() }))
      .query(async ({ ctx, input }) => {
        return await db.getActivitiesByCompany(input.companyId, input.limit);
      }),

    getDossier: salesProcedure
      .input(z.object({ contactId: z.string() }))
      .query(async ({ ctx, input }) => {
        const contact = await db.getContact(input.contactId);
        if (!contact) {
          throw new TRPCError({ code: 'NOT_FOUND', message: 'Contact not found' });
        }
        
        const activities = await db.getActivitiesByContact(input.contactId, 20);
        const company = contact.companyId ? await db.getCompany(contact.companyId) : null;
        const corporation = company?.corporationId ? await db.getCorporation(company.corporationId) : null;
        
        return {
          contact,
          company,
          corporation,
          activities,
        };
      }),

    create: salesProcedure
      .input(z.object({
        corporationId: z.string().optional(),
        companyId: z.string().optional(),
        contactId: z.string().optional(),
        activityType: z.string(),
        subject: z.string(),
        content: z.string().optional(),
        direction: z.string().optional(),
        outcome: z.string().optional(),
      }))
      .mutation(async ({ ctx, input }) => {
        return await db.createActivity({
           corporationId: input.corporationId || null,
        companyId: input.companyId || null,
        contactId: input.contactId || null,
        activityType: input.activityType || null,
        subject: input.subject || null,
        content: input.content || null,
        direction: input.direction || null,
        outcome: input.outcome || null,
        activityDate: null,
        emailMessageId: null,
        hasAttachment: false,
        attachmentCount: 0,
        createdBy: ctx.user.name || ctx.user.id,
        });
      }),
  }),

  // ==========================================================================
  // DASHBOARD & STATS
  // ==========================================================================

  dashboard: router({
    stats: salesProcedure.query(async ({ ctx }) => {
      return await db.getDashboardStats(ctx.user.id);
    }),
  }),

  // ==========================================================================
  // COMMISSIONS (External Sales)
  // ==========================================================================

  commissions: router({
    myCommissions: protectedProcedure.query(async ({ ctx }) => {
      if (ctx.user.role !== 'staff_plus') {
        throw new TRPCError({ code: 'FORBIDDEN', message: 'Only for staff+' });
      }
      return await db.getCommissionsByUser(ctx.user.id);
    }),
  }),

  // ==========================================================================
  // GLOBAL SEARCH
  // ==========================================================================
  
  search: router({
    global: protectedProcedure
      .input(z.object({ query: z.string() }))
      .query(async ({ input }) => {
        return await db.globalSearch(input.query);
      }),
  }),
});

export type AppRouter = typeof appRouter;

