import { useAuth } from "@/_core/hooks/useAuth";
import { Button } from "@/components/ui/button";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Dialog, DialogContent, DialogHeader, DialogTitle, DialogFooter } from "@/components/ui/dialog";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Textarea } from "@/components/ui/textarea";
import { trpc } from "@/lib/trpc";
import { Link, useParams } from "wouter";
import { useState } from "react";

export default function ContactDetail() {
  const { user } = useAuth();
  const { id } = useParams<{ id: string }>();
  
  // State für Bearbeitungs-Dialog
  const [isEditing, setIsEditing] = useState(false);
  const [editForm, setEditForm] = useState({
    firstName: '',
    lastName: '',
    email: '',
    phone: '',
    mobile: '',
    notes: '',
    isDecisionMaker: false
  });
  
  // Kontakt laden
  const { data: contact, isLoading: contactLoading, error: contactError, refetch } = trpc.contacts.get.useQuery(
    { id: id! },
    { enabled: !!id }
  );
  
  // Update Mutation
  const updateContactMutation = trpc.contacts.update.useMutation({
    onSuccess: () => {
      refetch();
      setIsEditing(false);
    }
  });
  
  // Firmen für diesen Kontakt laden - mit defensiver Programmierung
  const { data: companiesData } = trpc.contacts.getCompanies.useQuery(
    { contactId: id! },
    { enabled: !!id }
  );
  // Sicherstellen, dass companies immer ein Array ist
  const companies = Array.isArray(companiesData) ? companiesData : [];
  const primaryCompany = companies.find((c: any) => c.isPrimary) || companies[0];
  
  // Konzern laden
  const { data: corporation } = trpc.corporations.get.useQuery(
    { id: primaryCompany?.corporationId || '' },
    { enabled: !!primaryCompany?.corporationId }
  );
  
  // Aktivitäten laden - mit defensiver Programmierung
  const { data: activitiesData } = trpc.activities.listByContact.useQuery(
    { contactId: id!, limit: 20 },
    { enabled: !!id }
  );
  const activities = Array.isArray(activitiesData) ? activitiesData : [];

  // Bearbeiten starten
  const handleEdit = () => {
    if (contact) {
      setEditForm({
        firstName: contact.firstName || '',
        lastName: contact.lastName || '',
        email: contact.email || '',
        phone: contact.phone || '',
        mobile: contact.mobile || '',
        notes: contact.notes || '',
        isDecisionMaker: contact.isDecisionMaker || false
      });
      setIsEditing(true);
    }
  };

  // Speichern
  const handleSave = () => {
    if (id) {
      updateContactMutation.mutate({
        id,
        firstName: editForm.firstName,
        lastName: editForm.lastName,
        email: editForm.email || undefined,
        phone: editForm.phone || undefined,
        mobile: editForm.mobile || undefined,
        notes: editForm.notes || undefined,
        isDecisionMaker: editForm.isDecisionMaker
      });
    }
  };

  if (contactLoading) {
    return (
      <div className="min-h-screen flex items-center justify-center">
        <div className="text-lg">Lade Kontakt...</div>
      </div>
    );
  }

  if (contactError) {
    return (
      <div className="min-h-screen flex items-center justify-center">
        <div className="text-lg text-red-600">Fehler beim Laden: {contactError.message}</div>
      </div>
    );
  }

  if (!contact) {
    return (
      <div className="min-h-screen flex items-center justify-center">
        <div className="text-lg">Kontakt nicht gefunden</div>
      </div>
    );
  }

  return (
    <div className="min-h-screen bg-gray-50">
      <main className="container py-8 max-w-6xl mx-auto px-4">
        {/* Breadcrumb */}
        <div className="mb-6 text-sm text-gray-600">
          <Link href="/contacts">
            <a className="hover:underline text-blue-600">← Zurück zur Kontaktliste</a>
          </Link>
        </div>

        {/* Header mit Key-Infos */}
        <div className="bg-white rounded-lg shadow-sm border p-6 mb-6">
          <div className="flex items-start justify-between">
            <div>
              <h1 className="text-2xl font-bold text-gray-900">
                {contact.firstName} {contact.lastName}
              </h1>
              {primaryCompany && (
                <p className="text-gray-600 mt-1">
                  {primaryCompany.position && <span>{primaryCompany.position} bei </span>}
                  <Link href={`/companies/${primaryCompany.id}`}>
                    <a className="text-blue-600 hover:underline">{primaryCompany.name}</a>
                  </Link>
                </p>
              )}
              {corporation && (
                <p className="text-sm text-gray-500 mt-1">
                  Konzern: <Link href={`/corporations/${corporation.id}`}>
                    <a className="text-blue-600 hover:underline">{corporation.name}</a>
                  </Link>
                </p>
              )}
            </div>
            <div className="flex items-center gap-2">
              {contact.isDecisionMaker && (
                <span className="bg-green-100 text-green-800 text-xs font-medium px-2.5 py-0.5 rounded">
                  Entscheidungsträger
                </span>
              )}
              <Button onClick={handleEdit}>Bearbeiten</Button>
            </div>
          </div>
        </div>

        <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
          {/* Linke Spalte - Kontaktdaten */}
          <div className="lg:col-span-2 space-y-6">
            {/* Kontaktdaten */}
            <Card>
              <CardHeader>
                <CardTitle>Kontaktdaten</CardTitle>
              </CardHeader>
              <CardContent className="space-y-4">
                {contact.email && (
                  <div className="flex items-center gap-3">
                    <span className="text-gray-500 w-24">E-Mail:</span>
                    <a href={`mailto:${contact.email}`} className="text-blue-600 hover:underline">
                      {contact.email}
                    </a>
                  </div>
                )}
                {contact.phone && (
                  <div className="flex items-center gap-3">
                    <span className="text-gray-500 w-24">Telefon:</span>
                    <a href={`tel:${contact.phone}`} className="text-blue-600 hover:underline">
                      {contact.phone}
                    </a>
                  </div>
                )}
                {contact.mobile && (
                  <div className="flex items-center gap-3">
                    <span className="text-gray-500 w-24">Mobil:</span>
                    <a href={`tel:${contact.mobile}`} className="text-blue-600 hover:underline">
                      {contact.mobile}
                    </a>
                  </div>
                )}
                {!contact.email && !contact.phone && !contact.mobile && (
                  <p className="text-gray-500 italic">Keine Kontaktdaten hinterlegt</p>
                )}
              </CardContent>
            </Card>

            {/* Firmen-Zuordnungen */}
            <Card>
              <CardHeader>
                <CardTitle>Firmen-Zuordnungen ({companies.length})</CardTitle>
              </CardHeader>
              <CardContent>
                {companies.length > 0 ? (
                  <div className="space-y-3">
                    {companies.map((company: any) => (
                      <div key={company.id} className="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
                        <div>
                          <Link href={`/companies/${company.id}`}>
                            <a className="font-medium text-blue-600 hover:underline">{company.name}</a>
                          </Link>
                          {company.position && (
                            <p className="text-sm text-gray-500">{company.position}</p>
                          )}
                          {company.email && (
                            <p className="text-sm text-gray-500">{company.email}</p>
                          )}
                        </div>
                        {company.isPrimary && (
                          <span className="bg-blue-100 text-blue-800 text-xs font-medium px-2 py-0.5 rounded">
                            Primär
                          </span>
                        )}
                      </div>
                    ))}
                  </div>
                ) : (
                  <p className="text-gray-500 italic">Keine Firmen zugeordnet</p>
                )}
              </CardContent>
            </Card>

            {/* Aktivitäten */}
            <Card>
              <CardHeader>
                <CardTitle>Letzte Aktivitäten ({activities.length})</CardTitle>
              </CardHeader>
              <CardContent>
                {activities.length > 0 ? (
                  <div className="space-y-3">
                    {activities.slice(0, 10).map((activity: any) => (
                      <div key={activity.id} className="flex items-start gap-3 p-3 bg-gray-50 rounded-lg">
                        <div className="flex-1">
                          <p className="font-medium">{activity.activityType}</p>
                          <p className="text-sm text-gray-600">{activity.description}</p>
                          <p className="text-xs text-gray-400 mt-1">
                            {new Date(activity.activityDate).toLocaleDateString('de-DE')}
                          </p>
                        </div>
                      </div>
                    ))}
                  </div>
                ) : (
                  <p className="text-gray-500 italic">Keine Aktivitäten vorhanden</p>
                )}
              </CardContent>
            </Card>
          </div>

          {/* Rechte Spalte - Zusatzinfos */}
          <div className="space-y-6">
            {/* Notizen */}
            <Card>
              <CardHeader>
                <CardTitle>Notizen</CardTitle>
              </CardHeader>
              <CardContent>
                {contact.notes ? (
                  <p className="text-gray-700 whitespace-pre-wrap">{contact.notes}</p>
                ) : (
                  <p className="text-gray-500 italic">Keine Notizen vorhanden</p>
                )}
              </CardContent>
            </Card>

            {/* Meta-Informationen */}
            <Card>
              <CardHeader>
                <CardTitle>Informationen</CardTitle>
              </CardHeader>
              <CardContent className="space-y-2 text-sm">
                <div className="flex justify-between">
                  <span className="text-gray-500">Erstellt:</span>
                  <span>{new Date(contact.createdAt).toLocaleDateString('de-DE')}</span>
                </div>
                <div className="flex justify-between">
                  <span className="text-gray-500">Aktualisiert:</span>
                  <span>{new Date(contact.updatedAt).toLocaleDateString('de-DE')}</span>
                </div>
                <div className="flex justify-between">
                  <span className="text-gray-500">ID:</span>
                  <span className="font-mono text-xs">{contact.id}</span>
                </div>
              </CardContent>
            </Card>
          </div>
        </div>
      </main>

      {/* Bearbeitungs-Dialog */}
      <Dialog open={isEditing} onOpenChange={setIsEditing}>
        <DialogContent className="sm:max-w-[500px]">
          <DialogHeader>
            <DialogTitle>Kontakt bearbeiten</DialogTitle>
          </DialogHeader>
          <div className="grid gap-4 py-4">
            <div className="grid grid-cols-2 gap-4">
              <div className="space-y-2">
                <Label htmlFor="firstName">Vorname *</Label>
                <Input
                  id="firstName"
                  value={editForm.firstName}
                  onChange={(e) => setEditForm({ ...editForm, firstName: e.target.value })}
                  placeholder="Vorname"
                />
              </div>
              <div className="space-y-2">
                <Label htmlFor="lastName">Nachname *</Label>
                <Input
                  id="lastName"
                  value={editForm.lastName}
                  onChange={(e) => setEditForm({ ...editForm, lastName: e.target.value })}
                  placeholder="Nachname"
                />
              </div>
            </div>
            <div className="space-y-2">
              <Label htmlFor="email">E-Mail</Label>
              <Input
                id="email"
                type="email"
                value={editForm.email}
                onChange={(e) => setEditForm({ ...editForm, email: e.target.value })}
                placeholder="email@beispiel.de"
              />
            </div>
            <div className="grid grid-cols-2 gap-4">
              <div className="space-y-2">
                <Label htmlFor="phone">Telefon</Label>
                <Input
                  id="phone"
                  value={editForm.phone}
                  onChange={(e) => setEditForm({ ...editForm, phone: e.target.value })}
                  placeholder="+49 123 456789"
                />
              </div>
              <div className="space-y-2">
                <Label htmlFor="mobile">Mobil</Label>
                <Input
                  id="mobile"
                  value={editForm.mobile}
                  onChange={(e) => setEditForm({ ...editForm, mobile: e.target.value })}
                  placeholder="+49 170 1234567"
                />
              </div>
            </div>
            <div className="space-y-2">
              <Label htmlFor="notes">Notizen</Label>
              <Textarea
                id="notes"
                value={editForm.notes}
                onChange={(e) => setEditForm({ ...editForm, notes: e.target.value })}
                placeholder="Notizen zum Kontakt..."
                rows={3}
              />
            </div>
            <div className="flex items-center gap-2">
              <input
                type="checkbox"
                id="isDecisionMaker"
                checked={editForm.isDecisionMaker}
                onChange={(e) => setEditForm({ ...editForm, isDecisionMaker: e.target.checked })}
                className="h-4 w-4 rounded border-gray-300"
              />
              <Label htmlFor="isDecisionMaker">Entscheidungsträger</Label>
            </div>
          </div>
          <DialogFooter>
            <Button variant="outline" onClick={() => setIsEditing(false)}>Abbrechen</Button>
            <Button 
              onClick={handleSave} 
              disabled={updateContactMutation.isPending || !editForm.firstName || !editForm.lastName}
            >
              {updateContactMutation.isPending ? 'Speichern...' : 'Speichern'}
            </Button>
          </DialogFooter>
        </DialogContent>
      </Dialog>
    </div>
  );
}

