# FRIDAY CRM - Environment Variables
# Kopiere diese Datei nach .env und fülle alle Werte aus

# ── Datenbank ──────────────────────────────────────────────
DATABASE_URL=mysql://dbuser:dbpassword@localhost:3306/friday_crm

# ── Authentifizierung ──────────────────────────────────────
# Mindestens 32 Zeichen, kein Fallback-Wert!
# Generieren: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_RANDOM_32_CHAR_SECRET

# ── Verschlüsselung (Credentials) ─────────────────────────
# Mindestens 32 Zeichen, MUSS sich von JWT_SECRET unterscheiden!
# Generieren: openssl rand -hex 32
CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_DIFFERENT_32_CHAR_SECRET

# ── Server ─────────────────────────────────────────────────
NODE_ENV=production
PORT=3002
# DEV_MODE=true ist in NODE_ENV=production verboten
# DEV_MODE=true

# ── App ────────────────────────────────────────────────────
VITE_APP_TITLE=FRIDAY CRM
VITE_APP_LOGO=/logo.png

# ── KI / APIs ──────────────────────────────────────────────
OPENAI_API_KEY=sk-...
APOLLO_API_KEY=

# ── CalDAV (SmarterMail WebDAV) ────────────────────────────
CALDAV_BASE_URL=https://mail.example.com
CALDAV_USERS=user@example.com
CALDAV_USER_PASSWORD=

# ── Analytics (optional) ───────────────────────────────────
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
